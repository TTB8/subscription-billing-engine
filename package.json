{
  "name": "subscription-billing-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade subscription billing engine: fixed-day cycles, prepaid terms, dunning, idempotent Stripe webhooks.",
  "license": "MIT",
  "author": "TTB8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TTB8/subscription-billing-engine.git"
  },
  "bugs": {
    "url": "https://github.com/TTB8/subscription-billing-engine/issues"
  },
  "homepage": "https://github.com/TTB8/subscription-billing-engine#readme",
  "keywords": [
    "stripe",
    "nestjs",
    "prisma",
    "billing",
    "subscriptions",
    "typescript",
    "idempotency",
    "dunning"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:cov": "pnpm build:packages && pnpm -r test:cov",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "build": "pnpm build:packages && pnpm --filter @billing/api build",
    "test:e2e": "pnpm build:packages && pnpm --filter @billing/api test:e2e",
    "dev": "pnpm --filter @billing/api dev",
    "db:reset": "pnpm --filter @billing/api db:reset",
    "test:cov:api": "pnpm build:packages && pnpm --filter @billing/api test:cov:full"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "prettier": "^3.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
