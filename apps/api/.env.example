# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://billing:billing@localhost:5433/billing

# Stripe TEST mode only. Required outside NODE_ENV=test; the app refuses to boot without it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects the admin endpoints (plans, refunds). Use a long random value.
ADMIN_API_KEY=

# Runs the renewal and retry job every 5 minutes. Set to false on replicas that should only serve the API.
# Running it on several replicas is safe (charges are idempotent), just redundant.
RENEWAL_JOB_ENABLED=true
