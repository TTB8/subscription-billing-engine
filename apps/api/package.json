{
  "name": "@billing/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS billing API: checkout, renewals, dunning, refunds, Stripe webhooks.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:cov": "jest --config jest.config.js --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "pnpm --filter @billing/domain build && prisma migrate reset --force",
    "db:seed": "pnpm --filter @billing/domain build && prisma db seed",
    "build": "nest build",
    "dev": "pnpm --dir ../.. build:packages && nest start --watch",
    "start": "node dist/main.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "test:cov:full": "jest --config jest.cov.config.js --runInBand"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@billing/domain": "workspace:*",
    "@billing/gateway": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.19.0"
  }
}
